{
  "name": "aws-token-designer",
  "version": "0.1.0",
  "private": true,
  "description": "AWS port of the Firebase Token Designer",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run e2e --workspace @aws-token-designer/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": "22"
  }
}
