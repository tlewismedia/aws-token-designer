# Public frontend configuration (safe to commit — Cognito pool/client ids are
# public in OAuth clients). Copy to apps/web/.env.local and fill in from:
#   terraform -chdir=infra/envs/dev output user_pool_id
#   terraform -chdir=infra/envs/dev output client_id
VITE_AWS_REGION=us-west-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Local dev proxy target for /api (apps/web/vite.config.ts). Copy the
# execute-api URL: terraform -chdir=infra/envs/dev output api_url
# NOTE: for the proxy process itself (not exposed to the browser), keep the
# value in .env.local, which is gitignored.
VITE_API_URL=
